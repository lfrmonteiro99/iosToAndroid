# dependencies
node_modules/
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Gradle build output do modulo nativo. Nao esta coberto pela regra /android acima
# porque o modulo vive em modules/launcher-module/android/, fora da raiz — e apareceu
# como 5.2M de artefactos sem versionar a bloquear qualquer rebase do working tree.
modules/*/android/build/
